# 4399 CRM - environment variables (copy to .env.local for local overrides).
# Nothing is required locally: without DATABASE_URL the app uses
# web/data/app.db (created from the committed data/seed.db snapshot).

# libSQL / SQLite connection. Production: a Turso database URL, e.g.
#   libsql://<db-name>-<org>.turso.io
# Local file example: file:./data/app.db
DATABASE_URL=

# Auth token for Turso (leave empty for file: URLs).
DATABASE_AUTH_TOKEN=

# Secret used to sign session cookies (HS256). Use 32+ random characters, e.g.
#   openssl rand -base64 32
# REQUIRED on Vercel: the app refuses to sign sessions there without it.
# Locally (`pnpm dev`, or `pnpm build && pnpm start`) it may stay empty: a fixed,
# insecure development key is used and a warning is logged under `pnpm start`.
SESSION_SECRET=

# Optional: pin the seed's reference date (YYYY-MM-DD) for `pnpm db:seed` /
# `pnpm db:reset` / `pnpm db:snapshot` so the generated dates are reproducible.
SEED_ANCHOR=

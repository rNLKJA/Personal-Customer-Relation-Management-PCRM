# Environment for the ORIGINAL 2021 Express + Mongoose back-end (reference only).
# The original .env, Atlas URI and Gmail password were leaked in the team repo and
# are intentionally NOT included. Provide your own values to run it locally.
PORT=5000
# Any MongoDB you control, e.g. a local mongod. Database name "CRM" is set in code.
MONGODB_URI=mongodb://localhost:27017
# Secret used to sign JWTs (passport-jwt) and express-session.
PASSPORT_KEY=change-me
# Optional: Gmail account + app password for nodemailer verification e-mails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

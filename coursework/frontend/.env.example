# Environment for the ORIGINAL 2021 Create React App front-end (reference only).
# The original Google Maps key was revoked/removed; supply your own if you want
# to run this legacy client. The revived app in /web needs no map key at all.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-js-api-key
PORT=3000
BACK_END_API_PATH="http://localhost:5000"
SKIP_PREFLIGHT_CHECK=true
